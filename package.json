{
  "name": "@lenne.tech/nuxt-extensions",
  "version": "1.21.0",
  "description": "Reusable Nuxt 4 composables, components, and Better-Auth integration for lenne.tech projects",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lenneTech/nuxt-extensions.git"
  },
  "homepage": "https://github.com/lenneTech/nuxt-extensions#readme",
  "bugs": {
    "url": "https://github.com/lenneTech/nuxt-extensions/issues"
  },
  "author": "lenne.Tech <info@lenne.tech> (https://lenne.tech)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./lib": {
      "types": "./dist/runtime/lib/index.d.ts",
      "import": "./dist/runtime/lib/index.js"
    },
    "./testing": {
      "types": "./dist/runtime/testing/index.d.ts",
      "import": "./dist/runtime/testing/index.js"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      ".": [
        "./dist/types.d.mts"
      ],
      "lib": [
        "./dist/runtime/lib/index.d.ts"
      ],
      "testing": [
        "./dist/runtime/testing/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "CLAUDE.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "prepack": "node scripts/sync-module-version.mjs && nuxt-module-build build",
    "c": "pnpm run check",
    "check": "node scripts/check.mjs",
    "check:raw": "pnpm install --frozen-lockfile && pnpm audit && pnpm run check:suppressions && pnpm peers check && pnpm run format:check && pnpm run dev:prepare && pnpm run lint && pnpm run version:check && pnpm test:types && pnpm test && pnpm run build && pnpm run check:manifest",
    "check:fix": "pnpm install && pnpm audit --fix && pnpm run check:suppressions && pnpm peers check && pnpm run format && pnpm run dev:prepare && pnpm run lint:fix && pnpm run version:sync && pnpm test:types && pnpm test && pnpm run build && pnpm run check:manifest",
    "check:naf": "pnpm install && pnpm peers check && pnpm run format && pnpm run dev:prepare && pnpm run lint:fix && pnpm run version:sync && pnpm test:types && pnpm test && pnpm run build && pnpm run check:manifest",
    "cf": "pnpm run check:fix",
    "cnaf": "pnpm run check:naf",
    "dev": "pnpm dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "build": "nuxt-module-build build",
    "lint": "oxlint --type-aware src/ scripts/",
    "lint:fix": "oxlint --type-aware --fix src/ scripts/",
    "format": "oxfmt --write src/",
    "format:check": "oxfmt --check src/",
    "version:sync": "node scripts/sync-module-version.mjs",
    "version:check": "node scripts/sync-module-version.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:types": "vue-tsc --noEmit && vue-tsc --noEmit -p src/runtime/server && cd playground && vue-tsc --noEmit",
    "release": "pnpm format:check && pnpm run dev:prepare && pnpm lint && pnpm run version:check && pnpm test:types && pnpm test && pnpm run check:consumer && pnpm prepack",
    "check:consumer": "node scripts/check-consumer-build.mjs",
    "check:manifest": "node scripts/check-package-manifest.mjs",
    "check:suppressions": "node scripts/check-suppressions.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0"
  },
  "peerDependencies": {
    "@better-auth/passkey": ">=1.7.12 <1.8.0",
    "@playwright/test": ">=1.0.0",
    "better-auth": ">=1.7.12 <1.8.0",
    "nuxt": "^4.0.0",
    "tus-js-client": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "better-auth": {
      "optional": false
    },
    "@better-auth/passkey": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "tus-js-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@better-auth/passkey": "1.7.12",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.6.3",
    "@nuxt/ui": "4.12.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "@vue/server-renderer": "3.5.44",
    "better-auth": "1.7.12",
    "cross-spawn": "7.0.6",
    "happy-dom": "21.0.4",
    "nuxt": "4.6.3",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "reka-ui": "2.11.0",
    "tus-js-client": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "vue-tsc": "3.3.13"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "nuxt4",
    "vue3",
    "better-auth",
    "authentication",
    "passkey",
    "webauthn",
    "tus-upload",
    "file-upload",
    "lenne-tech"
  ],
  "engines": {
    "node": ">= 22",
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.28.9+sha512.35421cea2720eca3f5ad722b67e8ef18f4d3cd4745ed2fcfeb0dc288d4e9437fad3870d91ee6e83f268f0f6f7e0f62723317b19617bb45ee4333172ef51159f8"
}
